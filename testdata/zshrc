# ~/.zshrc  (pretty-alias fixture: realistic, diverse, valid for the current parser)
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git docker kubectl fzf zsh-autosuggestions zsh-syntax-highlighting)
source $ZSH/oh-my-zsh.sh

autoload -Uz compinit && compinit
autoload -Uz vcs_info
setopt AUTO_CD HIST_IGNORE_DUPS SHARE_HISTORY EXTENDED_GLOB INTERACTIVE_COMMENTS
bindkey -e
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

export EDITOR="nvim"
export VISUAL="$EDITOR"
export LESS="-R --use-color"
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
typeset -U path
path=("$HOME/.local/bin" "$HOME/.cargo/bin" $path)

eval "$(zoxide init zsh)"
eval "$(starship init zsh)"

# ------------------------------------------------------------ zoxide / fzf
alias z='zoxide'
alias zi='zoxide query -i'
alias fcd='cd "$(fd --type d | fzf)"'
alias fe='nvim "$(fzf --preview "bat --color=always {}")"'
alias fkill='ps -ef | fzf | awk "{print \$2}" | xargs kill -9'
alias fgb='git branch --all | fzf | xargs git checkout'
alias fh='history 1 | fzf --tac | sed "s/^ *[0-9]* *//"'

# ------------------------------------------------------------ listing
