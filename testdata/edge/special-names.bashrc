# Names made of punctuation, digits, dots, dashes, quotes.
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ~='cd ~'
alias /='cd /'
alias -- -='cd -'
alias _='sudo'
alias __='echo double underscore'
alias 1='cd 1'
alias 007='echo bond'
alias a1b2='echo mixed'
alias git-st='git status'
alias git.st='git status'
alias 'quoted-name'='echo quoted name'
alias "dq-name"='echo dq name'
alias ls?='echo question'
alias ls+='echo plus'
alias ls@='echo at'
alias ls%='echo percent'
alias ls,='echo comma'
alias ls:='echo colon'
alias ls^='echo caret'
alias ls\ space='echo escaped space'
alias CamelCase='echo camel'
alias UPPER='echo upper'
