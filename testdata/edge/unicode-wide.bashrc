# Wide / combining / emoji characters stress column width and wrapping.
alias 日本語='echo こんにちは世界'
alias 中文='echo 你好，世界'
alias 한국어='echo 안녕하세요 세계'
alias emoji_cmd='echo "🚀✨🔥🧪🐛✅❌ rocket"'
alias 🚀='echo launch'
alias 🙂='echo smile'
alias ünïcödé='echo "café naïve résumé Zürich Ångström"'
alias combining='echo "é = e + ́  ;  ñ = n + ̃"'
alias zwj='echo "👨‍👩‍👧‍👦 family  🏳️‍🌈 flag  👍🏽 skin tone"'
alias rtl='echo "שלום עולם  مرحبا بالعالم"'
alias fullwidth='echo "ＡＢＣ１２３ ｆｕｌｌｗｉｄｔｈ"'
alias box='echo "┌──┬──┐ │  │  │ └──┴──┘ ▁▂▃▄▅▆▇█"'
alias math='echo "∑ ∏ √ ∞ ≈ ≠ ≤ ≥ ∂ ∫ π"'
alias mixed='echo "ascii 日本語 emoji 🚀 combining é end"'
alias nbsp='echo "non breaking spaces here"'
alias wide_long='echo "日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語日本語"'
