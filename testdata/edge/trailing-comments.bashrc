# Trailing comments (issue #12, and the descriptions feature). Expected command shown WITHOUT the comment.
alias ll='ls -la' # list everything
alias gs='git status' # Short status
alias gp='git push'   #    push
alias hashtag='echo "a # b"' # the # inside quotes is part of the command
alias url='xdg-open "https://example.com/#anchor"' # fragment in quotes
alias unquoted=ls # comment after unquoted value
alias nocomment='ls'
